{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "检查环境（启动即暂停）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_env.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "stopOnEntry": true
    },
    {
      "name": "调试当前 Python 文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
